# PotBot MCP Server — copy to .env and fill in values
# All variables are optional — defaults are shown below

# ── Solana ──────────────────────────────────────────────────────────────────
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet

# ── Program ─────────────────────────────────────────────────────────────────
PROGRAM_ID=2ywztkP4gaJr2HtmBvqMXrBWab3FLd3uG6TjGXvVogJL

# ── PotBot API (backend) ─────────────────────────────────────────────────────
POTBOT_API_URL=https://api.potbot.fun

# ── HTTP Server (for HTTP+SSE transport mode) ────────────────────────────────
PORT=3002

# ── x402 Micropayments ───────────────────────────────────────────────────────
# Enable x402 payment gate for premium analytics tools
X402_ENABLED=false

# Price per paid tool call in USDC (get_vault_analytics, get_yield_rates, get_leaderboard)
X402_PRICE_USDC=0.001

# Your USDC wallet address that receives payments from AI agents
# X402_RECEIVER_WALLET=your-usdc-wallet-address

# ── Agent Keypair (optional) ─────────────────────────────────────────────────
# Base58 private key for autonomous proposal creation
# WARNING: Keep this secret — never commit it, use fly secrets or env injection
# AGENT_KEYPAIR=your-base58-private-key

# ── Market & Sentiment data sources (optional) ───────────────────────────────
# CoinGecko + DefiLlama work key-less. The two below extend the
# get_social_sentiment tool with real Twitter / news data instead of just Reddit.
#
# LunarCrush — Twitter sentiment per coin, top influencer posts.
#   Sign up: https://lunarcrush.com/developers
# LUNARCRUSH_API_KEY=
#
# CryptoPanic — crypto news headlines per coin with vote-derived sentiment.
#   Sign up: https://cryptopanic.com/developers/api/
# CRYPTOPANIC_API_KEY=
