{
  "name": "@potbot/mcp",
  "version": "0.2.0",
  "description": "PotBot MCP server — AI agent interface for on-chain group vaults on Solana",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "potbot-mcp": "dist/index.js",
    "potbot-mcp-http": "dist/http.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/http.ts",
    "build": "tsc && chmod +x dist/index.js dist/http.js",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "start:http:x402": "X402_ENABLED=true node dist/http.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solana",
    "potbot",
    "ai-agent",
    "claude",
    "vault",
    "defi",
    "x402",
    "jupiter",
    "anchor"
  ],
  "author": "PotBot (YD811)",
  "license": "MIT",
  "homepage": "https://potbot.fun/for-agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YD811/potbot-v2.git",
    "directory": "apps/potbot-mcp"
  },
  "bugs": {
    "url": "https://github.com/YD811/potbot-v2/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@solana/web3.js": "^1.91.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5"
  }
}
