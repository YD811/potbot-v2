{
  "name": "@potbot/mcp",
  "version": "0.2.0",
  "description": "PotBot MCP server — AI agent interface for on-chain group vaults",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "potbot-mcp": "dist/index.js",
    "potbot-mcp-http": "dist/http.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/http.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "start:http:x402": "X402_ENABLED=true node dist/http.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "solana",
    "potbot",
    "ai-agent",
    "defi",
    "x402"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@solana/web3.js": "^1.91.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5"
  }
}
