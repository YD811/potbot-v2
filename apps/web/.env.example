# ── Solana ──────────────────────────────────────────────────────────────────
# Network: devnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# RPC endpoint (use Helius/Quicknode for production)
# Centralized Solana RPC URL for web/client usage
# https://mainnet.helius-rpc.com/?api-key=YOUR_KEY  — fallback to public RPC
NEXT_PUBLIC_SOLANA_RPC_URL=

NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Anchor program ID (set after `anchor deploy`)
# Run: anchor keys list
NEXT_PUBLIC_PROGRAM_ID=2ywztkP4gaJr2HtmBvqMXrBWab3FLd3uG6TjGXvVogJL
# optional override; defaults to mainnet Squads v4 program
NEXT_PUBLIC_SQUADS_PROGRAM_ID=

# ── PotBot API ───────────────────────────────────────────────────────────────
# Base URL of this app (used for internal API calls)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Vercel Cron ──────────────────────────────────────────────────────────────
# Set automatically by Vercel — leave empty for local dev
# CRON_SECRET=

# ── Optional: Helius RPC (better rate limits + Webhooks) ────────────────────
# HELIUS_API_KEY=

# ── Optional: Supabase (for server-side agent rules storage) ────────────────
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ── Optional: MagicBlock / Privacy payments ──────────────────────────────────
# MAGICBLOCK_API_KEY=
