# PotBot keeper — env reference. Copy to apps/keeper/.env (gitignored) and fill in.

# ─── Solana RPC + program ─────────────────────────────────────────────────────
# Variable names accepted by the keeper. Either spelling works:
#   POTBOT_PROGRAM_ID (canonical) — read by index.ts and worker.ts
#   PROGRAM_ID — legacy, also OK if you only set one
SOLANA_RPC_URL=https://api.devnet.solana.com
POTBOT_PROGRAM_ID=GJap9DjUoKZ9dhXMqGCPTeTzY6kPyBJ51SXL1pi8AmiK

# ─── Worker tuning ────────────────────────────────────────────────────────────
KEEPER_SYNC_INTERVAL_MS=30000
KEEPER_LEADERBOARD_INTERVAL_MS=300000
KEEPER_ENABLE_WORKER=true
KEEPER_PORT=8787

# ─── Supabase (service-role — server-only, NEVER expose to web) ───────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ─── Optional: Dune SIM (vault balance monitoring) ────────────────────────────
DUNE_API_KEY=

# ─── Helius webhooks ──────────────────────────────────────────────────────────
HELIUS_WEBHOOK_SECRET=  # set in Helius dashboard.

# ─── Index-vault cranks (NAV + redeem settler) ────────────────────────────────
# Keeper signing key: file path OR raw JSON array (from a secret manager).
# This key is crank-only — it can never move funds to itself. Fund with gas SOL.
KEEPER_KEYPAIR_PATH=
KEEPER_KEYPAIR_JSON=
KEEPER_ENABLE_INDEX_CRANK=true
KEEPER_NAV_INTERVAL_MS=60000
KEEPER_MAX_SETTLES_PER_TICK=5
