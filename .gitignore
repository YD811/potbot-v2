# ── Environment files (NEVER commit) ──────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# ── Secrets, keypairs, certificates (NEVER commit) ────────────────
*.pem
*.key
*.secret
*keypair.json
*wallet.json
*deployer.json
deploy-keypair.json
id.json
secrets/

# Anchor deploy artifacts contain program keys
packages/program/target/deploy/*.json
packages/program/.anchor/

# ── App-specific build outputs ────────────────────────────────────
apps/web/.next/
apps/web/next-env.d.ts

# ── Local-only scratch / per-machine state ────────────────────────
_local/
_deploy/
POTBOT_OPUS/
.claude/worktrees/
.claire/

# Demo script logs (the .gitkeep itself is tracked)
logs/*.json

