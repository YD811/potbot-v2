node_modules/
.pnp
.pnp.js
coverage/
build/
dist/
out/
.vol/
.turbo/
target/
.anchor/
*.tsbuildinfo

# ── Editor / OS noise ─────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# ── Logs ──────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
