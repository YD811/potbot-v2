# ──────────────────────────────────────────────────────────────────
#  POTBOT — example environment configuration
# ──────────────────────────────────────────────────────────────────
#  Copy to apps/web/.env.local and fill in your own values.
#  Never commit a real .env file. Anything prefixed NEXT_PUBLIC_ is
#  exposed to the browser bundle.
# ──────────────────────────────────────────────────────────────────


# ── Network ────────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_CLUSTER=devnet               # devnet · mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_NETWORK=devnet
NEXT_PUBLIC_COMMITMENT=confirmed                # processed · confirmed · finalized
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com    # server-side fallback


# ── Helius (RPC + webhooks) ────────────────────────────────────────
NEXT_PUBLIC_HELIUS_RPC=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
HELIUS_WEBHOOK_SECRET=replace_with_random_hex   # HMAC for /api/webhooks/helius


# ── Onchain program + flagship POT ─────────────────────────────────
NEXT_PUBLIC_PROGRAM_ID=GJap9DjUoKZ9dhXMqGCPTeTzY6kPyBJ51SXL1pi8AmiK
NEXT_PUBLIC_ONE_POT_PUBKEY=                     # leave blank until a flagship pot exists
NEXT_PUBLIC_SQUADS_PROGRAM_ID=SQDS4ej4QxQp2hUe5xWbwppjfPcfTcJzPJrTAmzfYjV


# ── App ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=                            # only if running the deprecated apps/api server
NEXT_PUBLIC_MODE=mock                           # mock · onchain
NEXT_PUBLIC_MOCK_MODE=true                      # render seeded pots when no program is reachable


# ── Supabase (off-chain index) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...     # browser-safe anon key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...         # server-only — NEVER expose to the client


# ── BOT — agent orchestration ──────────────────────────────────────
AGENT_KEYPAIR=                                  # base58-encoded keypair, ONLY in server env
CRON_SECRET=replace_with_random_hex             # protects /api/cron/* from public invocation


# ── External services ─────────────────────────────────────────────
JUPITER_API_KEY=                                # optional, raises rate limit
NEXT_PUBLIC_DUNE_API_KEY=                       # optional, analytics dashboards


# ── Email (waitlist + transactional) ──────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=hello@potbot.fun


# ── Admin ─────────────────────────────────────────────────────────
ADMIN_SECRET=replace_with_random_hex            # gates /api/admin/*
NEXT_PUBLIC_ADMIN_PASSWORD=                     # client-side admin panel guard


# ── Treasury sweep (rare, server-only) ────────────────────────────
SWEEP_MASTER_SECRET=replace_with_random_hex
